-- 15. SORTEIO
-- =============================================================================
-- Regras (todas garantidas aqui no banco, nunca no navegador):
--   • Elegível = cliente REAL (profiles, com e-mail/nome/código) com ao menos
--     um pedido PAGO e total > 0.
--   • sorteio_listar_participantes()         -> só admin; usada pra girar.
--   • sorteio_listar_participantes_publico() -> lista pública (nome abreviado
--     + código de sorteio); nunca devolve e-mail nem telefone.
--   • sorteio_definir_ganhador()             -> só admin; recusa qualquer
--     código que não seja de um cliente real elegível.
--   • Participantes de "exemplo" mostrados no site NÃO existem no banco e,
--     portanto, jamais podem ser sorteados nem definidos como ganhador.
-- =============================================================================

create or replace function public.sorteio_listar_participantes()
returns table(
  nome text,
  codigo_cliente text
)
language plpgsql
security definer
set search_path = public
as $$
begin
  if not public.is_admin() then
    raise exception 'Apenas administradores podem listar participantes.';
  end if;

  return query
    select distinct
      p.full_name,
      p.codigo_cliente
    from public.profiles p
    join public.orders o
      on o.customer_id = p.id
     and o.status = 'PAGO'
     and o.total > 0
    where p.codigo_cliente is not null
    order by 1;
end;
$$;

