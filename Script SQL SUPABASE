-- =============================================================================
-- 11. CONFIRMAÇÃO DE PAGAMENTO
-- =============================================================================

create or replace function public.confirmar_pagamento_pix(
  p_order_id uuid,
  p_txid text default null
)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_order         public.orders;
  v_item          jsonb;
  v_comissao_pct  numeric;
  v_anunciante_id uuid;
  v_afiliado_id   uuid;
begin
  select *
  into v_order
  from public.orders
  where id = p_order_id
  for update;

  if not found then
    return jsonb_build_object(
      'ok', false,
      'error', 'Pedido não encontrado.'
    );
  end if;

  if v_order.status = 'PAGO' then
    return jsonb_build_object(
      'ok', true,
      'already', true,
      'orderId', v_order.id
    );
  end if;

  if v_order.status = 'CANCELADO' or v_order.status = 'EXPIRADO' then
    return jsonb_build_object(
      'ok', false,
      'error', 'Este pedido não está disponível para confirmação.'
    );
  end if;

  update public.orders
  set
    status   = 'PAGO',
    paid_at  = now(),
    pix_txid = coalesce(p_txid, pix_txid)
  where id = p_order_id;

  -- Baixa do estoque no momento da liberação.
  for v_item in
    select *
    from jsonb_array_elements(coalesce(v_order.items, '[]'::jsonb))
  loop
    update public.products
    set stock = greatest(
      stock - coalesce((v_item->>'quantity')::integer, 1),
      0
    )
    where id = (v_item->>'productId')::uuid
      and type = 'UNICO'
      and stock is not null;
  end loop;

  -- Venda de anunciante: somente pedidos realmente pagos e > R$ 0.
  if v_order.total > 0 and v_order.anunciante_codigo is not null then

    select id
    into v_anunciante_id
    from public.anunciantes
    where codigo = v_order.anunciante_codigo
    limit 1;

    if v_anunciante_id is not null then

      update public.anunciantes
      set total_vendas = total_vendas + 1
      where id = v_anunciante_id;

      insert into public.historico_vendas_anunciantes (
        anunciante_id,
        order_id,
        produto_nome,
        valor_compra,
        cliente_nome
      )
      values (
        v_anunciante_id,
        v_order.id,
        (
          select string_agg(it->>'name', ', ')
          from jsonb_array_elements(coalesce(v_order.items, '[]'::jsonb)) it
        ),
        v_order.total,
        v_order.customer_name
      );
    end if;
  end if;

  -- Comissão de afiliado somente sobre pedidos realmente pagos > R$ 0.
  if v_order.total > 0 and v_order.afiliado_id is not null then

    select id
    into v_afiliado_id
    from public.profiles
    where id = v_order.afiliado_id
      and is_afiliado = true
      and id <> v_order.customer_id
    limit 1;

    if v_afiliado_id is not null then

      select coalesce(valor::numeric, 10)
      into v_comissao_pct
      from public.app_config
      where chave = 'afiliado_comissao_percentual';

      insert into public.afiliados_indicacoes (
        afiliado_id,
        cliente_id,
        order_id,
        valor_venda,
        comissao,
        status
      )
      values (
        v_afiliado_id,
        v_order.customer_id,
        v_order.id,
        v_order.total,
        round(
          v_order.total *
          (coalesce(v_comissao_pct, 10) / 100.0),
          2
        ),
        'pendente'
      );
    end if;
  end if;

  return jsonb_build_object(
    'ok', true,
    'orderId', v_order.id
  );
end;
$$;

revoke all on function public.confirmar_pagamento_pix(uuid, text)
from public, anon, authenticated;

grant execute on function public.confirmar_pagamento_pix(uuid, text)
to service_role;


-- =============================================================================
-- 12. CRIAR PIX V2 — ÚNICA IMPLEMENTAÇÃO OFICIAL DO CHECKOUT
-- =============================================================================
-- Esta função:
--   - ignora qualquer preço enviado pelo navegador;
--   - recalcula preço no banco;
--   - valida produto, tipo, plano e estoque;
--   - aceita código de anunciante ou afiliado;
--   - impede autoafiliado;
--   - aceita cupom promocional;
--   - permite pedido gratuito sem gateway;
--   - monta requisição Pix usando template configurável;
--   - registra resposta do gateway;
--   - retorna debug somente quando pix_gateway_debug = true.
--
-- Placeholders disponíveis no template:
--   {{valor_json}}              ex.: 6.00
--   {{valor_centavos}}          ex.: 600
--   {{descricao_json}}          ex.: "Pedido NovaStore #..."
--   {{order_id_json}}           ex.: "uuid"
--   {{nome_json}}               ex.: "Nome"
--   {{email_json}}              ex.: "email@..."
--   {{valor}}                   alias numérico
--   {{order_id}}                UUID em texto
-- =============================================================================

create or replace function public.criar_pix_v2(
  p_name              text,
  p_email             text,
  p_items             jsonb,
  p_customer_id       uuid default null,
  p_anunciante_codigo text default null,
  p_afiliado_id       uuid default null,
  p_cupom_codigo      text default null
)
returns jsonb
language plpgsql
security definer
set search_path = public, extensions
as $$
declare
  v_subtotal                numeric(10,2) := 0;
  v_desconto                numeric(10,2) := 0;
  v_total_bruto             numeric(10,2) := 0;
  v_total                   numeric(10,2) := 0;

  v_tem_codigo              boolean := false;
  v_codigo_afiliado_usado   text := null;
  v_anunciante_codigo       text := null;
  v_cupom_codigo_usado      text := null;

  v_order_id                uuid;
  v_item                    jsonb;
  v_items_reais             jsonb := '[]'::jsonb;

  v_product                 public.products;
  v_product_id              uuid;
  v_quantity                integer;
  v_plan_id                 integer;
  v_plan                    jsonb;
  v_item_price              numeric(10,2);
  v_item_plan_name          text;

  v_cupom                   public.cupons;
  v_desconto_minimo_codigo  numeric := 80;
  v_max_qtd_item             constant integer := 20;

  v_gateway_url             text;
  v_gateway_token           text;
  v_gateway_auth_header     text;
  v_gateway_auth_prefix     text;
  v_gateway_template        text;
  v_gateway_payload_text    text;
  v_gateway_payload         jsonb;

  v_http_response            extensions.http_response;
  v_gateway_body_text       text;
  v_gateway_body             jsonb;

  v_pix_qrcode_base64        text;
  v_pix_copia_cola            text;
  v_pix_txid                 text;
  v_pix_expira               timestamptz;

  v_debug                    boolean := false;
  v_debug_text               text;
  v_confirm                  jsonb;

  v_descricao                text;
begin
  -- O checkout do front exige login.
  if auth.uid() is null then
    return jsonb_build_object(
      'error', 'Faça login antes de finalizar a compra.'
    );
  end if;

  -- O cliente só pode criar pedido para si.
  if p_customer_id is null then
    p_customer_id := auth.uid();
  elsif p_customer_id <> auth.uid() and not public.is_admin() then
    return jsonb_build_object(
      'error', 'Cliente inválido para este checkout.'
    );
  end if;

  if p_name is null or length(trim(p_name)) < 2 then
    return jsonb_build_object(
      'error', 'Informe seu nome completo.'
    );
  end if;

  if p_email is null or position('@' in p_email) = 0 then
    return jsonb_build_object(
      'error', 'Informe um e-mail válido.'
    );
  end if;

  if p_items is null
     or jsonb_typeof(p_items) <> 'array'
     or jsonb_array_length(p_items) = 0 then
    return jsonb_build_object(
      'error', 'Carrinho vazio.'
    );
  end if;

  -- ===========================================================
  -- 1) Recalcula itens e preços usando somente o banco.
  -- ===========================================================
  for v_item in
    select *
    from jsonb_array_elements(p_items)
  loop

    begin
      v_product_id := (v_item->>'productId')::uuid;
    exception
      when others then
        return jsonb_build_object(
          'error', 'Item do carrinho inválido.'
        );
    end;

    begin
      v_quantity := floor(
        coalesce((v_item->>'quantity')::numeric, 0)
      )::integer;
    exception
      when others then
        return jsonb_build_object(
          'error', 'Quantidade inválida para um dos itens.'
        );
    end;

    if v_quantity is null or v_quantity <= 0 then
      return jsonb_build_object(
        'error', 'Quantidade inválida para um dos itens.'
      );
    end if;

    if v_quantity > v_max_qtd_item then
      return jsonb_build_object(
        'error',
        'Quantidade muito alta para um único item (máximo ' ||
        v_max_qtd_item || ' por item).'
      );
    end if;

    -- Bloqueio curto da linha do produto durante a validação.
    select *
    into v_product
    from public.products
    where id = v_product_id
    for update;

    if not found then
      return jsonb_build_object(
        'error', 'Um dos produtos do carrinho não existe mais.'
      );
    end if;

    if not v_product.active then
      return jsonb_build_object(
        'error',
        'O produto "' || v_product.name ||
        '" não está mais disponível.'
      );
    end if;

    v_plan_id := null;
    v_item_plan_name := null;

    if v_product.type = 'ASSINATURA' then

      if v_item->>'planId' is null
         or trim(v_item->>'planId') = '' then
        return jsonb_build_object(
          'error',
          'Selecione um plano para "' ||
          v_product.name || '".'
        );
      end if;

      begin
        v_plan_id := (v_item->>'planId')::integer;
      exception
        when others then
          return jsonb_build_object(
            'error',
            'Plano inválido para "' ||
            v_product.name || '".'
          );
      end;

      if v_plan_id < 0
         or v_plan_id >= jsonb_array_length(
              coalesce(v_product.plans, '[]'::jsonb)
            ) then
        return jsonb_build_object(
          'error',
          'Plano inválido para "' ||
          v_product.name || '".'
        );
      end if;

      v_plan := v_product.plans -> v_plan_id;

      if v_plan is null
         or v_plan->>'price' is null then
        return jsonb_build_object(
          'error',
          'Plano sem preço configurado para "' ||
          v_product.name || '".'
        );
      end if;

      begin
        v_item_price := (v_plan->>'price')::numeric(10,2);
      exception
        when others then
          return jsonb_build_object(
            'error',
            'Preço inválido no plano de "' ||
            v_product.name || '".'
          );
      end;

      if v_item_price < 0 then
        return jsonb_build_object(
          'error',
          'Preço inválido no plano de "' ||
          v_product.name || '".'
        );
      end if;

      v_item_plan_name := v_plan->>'name';

    else

      if v_product.price is null then
        return jsonb_build_object(
          'error',
          'Produto "' ||
          v_product.name ||
          '" está sem preço configurado.'
        );
      end if;

      if v_product.price < 0 then
        return jsonb_build_object(
          'error',
          'Produto "' ||
          v_product.name ||
          '" possui preço inválido.'
        );
      end if;

      v_item_price := v_product.price;

      if v_product.stock is not null
         and v_product.stock < v_quantity then
        return jsonb_build_object(
          'error',
          'Estoque insuficiente para "' ||
          v_product.name || '".'
        );
      end if;
    end if;

    v_subtotal :=
      v_subtotal +
      (v_item_price * v_quantity);

    -- NÃO grava nome/preço do navegador:
    -- o pedido recebe apenas os dados reconstruídos pelo banco.
    v_items_reais :=
      v_items_reais ||
      jsonb_build_array(
        jsonb_build_object(
          'productId', v_product_id,
          'planId',    v_plan_id,
          'name',      v_product.name,
          'planName',  v_item_plan_name,
          'price',     v_item_price,
          'quantity',  v_quantity
        )
      );

  end loop;


  -- ===========================================================
  -- 2) Código de anunciante / afiliado.
  -- ===========================================================

  if p_anunciante_codigo is not null
     and trim(p_anunciante_codigo) <> '' then

    select codigo
    into v_anunciante_codigo
    from public.anunciantes
    where upper(trim(codigo)) =
          upper(trim(p_anunciante_codigo))
    limit 1;

    if v_anunciante_codigo is not null then
      v_tem_codigo := true;
    end if;
  end if;


  if not v_tem_codigo
     and p_afiliado_id is not null
     and p_afiliado_id <> p_customer_id then

    select codigo_afiliado
    into v_codigo_afiliado_usado
    from public.profiles
    where id = p_afiliado_id
      and is_afiliado = true
      and codigo_afiliado is not null
    limit 1;

    if v_codigo_afiliado_usado is not null then
      v_tem_codigo := true;
    end if;
  end if;


  if v_tem_codigo
     and v_subtotal >= v_desconto_minimo_codigo then

    v_desconto :=
      round(v_subtotal * 0.10, 2);

  end if;


  -- ===========================================================
  -- 3) Cupom promocional.
  -- ===========================================================

  if p_cupom_codigo is not null
     and trim(p_cupom_codigo) <> '' then

    select *
    into v_cupom
    from public.cupons
    where upper(trim(codigo)) =
          upper(trim(p_cupom_codigo))
    for update;

    if not found then
      return jsonb_build_object(
        'error', 'Cupom não encontrado.'
      );
    end if;

    if coalesce(v_cupom.ativo, true) is not true then
      return jsonb_build_object(
        'error', 'Este cupom não está mais ativo.'
      );
    end if;

    if v_cupom.expira_em is not null
       and v_cupom.expira_em < current_date then
      return jsonb_build_object(
        'error', 'Este cupom expirou.'
      );
    end if;

    if v_cupom.limite_uso is not null
       and coalesce(v_cupom.usos_atual, 0) >=
           v_cupom.limite_uso then
      return jsonb_build_object(
        'error',
        'Este cupom já atingiu o limite de usos.'
      );
    end if;

    if v_subtotal <
       coalesce(v_cupom.valor_minimo_compra, 0) then
      return jsonb_build_object(
        'error',
        'Esse cupom vale a partir de ' ||
        to_char(
          coalesce(v_cupom.valor_minimo_compra, 0),
          'FM999990.00'
        ) ||
        '.'
      );
    end if;

    if v_cupom.tipo_desconto = 'percentual' then
      v_desconto :=
        round(
          v_subtotal *
          (coalesce(v_cupom.valor, 0) / 100.0),
          2
        );
    else
      v_desconto :=
        least(
          coalesce(v_cupom.valor, 0),
          v_subtotal
        );
    end if;

    v_cupom_codigo_usado := v_cupom.codigo;

    -- Não acumula com o desconto de indicação.
    v_tem_codigo := true;

    update public.cupons
    set
      usos_atual = coalesce(usos_atual, 0) + 1,
      usos       = coalesce(usos, coalesce(usos_atual, 0) + 1),
      updated_at = now()
    where id = v_cupom.id;
  end if;


  -- ===========================================================
  -- 4) Total final, antes do piso da cobrança Pix.
  -- ===========================================================

  v_total_bruto :=
    round(v_subtotal - v_desconto, 2);


  -- ===========================================================
  -- 5) PEDIDO GRÁTIS:
  --    não chama o gateway.
  -- ===========================================================

  if v_total_bruto <= 0 then

    insert into public.orders (
      customer_id,
      customer_name,
      customer_email,
      items,
      total,
      status,
      anunciante_codigo,
      codigo_afiliado_usado,
      afiliado_id,
      cupom_usado,
      desconto_aplicado,
      cupom_codigo_usado
    )
    values (
      p_customer_id,
      trim(p_name),
      lower(trim(p_email)),
      v_items_reais,
      0,
      'PENDENTE',
      v_anunciante_codigo,
      v_codigo_afiliado_usado,
      p_afiliado_id,
      v_cupom_codigo_usado is not null,
      v_desconto,
      v_cupom_codigo_usado
    )
    returning id into v_order_id;

    v_confirm :=
      public.confirmar_pagamento_pix(
        v_order_id,
        null
      );

    if v_confirm is null
       or (v_confirm->>'ok') is distinct from 'true' then

      return jsonb_build_object(
        'error',
        'Não foi possível liberar o pedido gratuito automaticamente. ' ||
        'Pedido: #' || v_order_id || '.'
      );
    end if;

    return jsonb_build_object(
      'orderId', v_order_id,
      'free', true
    );
  end if;


  v_total := greatest(
    round(v_total_bruto, 2),
    0.01
  );


  -- ===========================================================
  -- 6) Validação/configuração do gateway ANTES de chamar HTTP.
  -- ===========================================================

  select valor
  into v_gateway_url
  from public.app_config
  where chave = 'pix_gateway_url';

  select valor
  into v_gateway_token
  from public.app_config
  where chave = 'pix_gateway_token';

  select valor
  into v_gateway_auth_header
  from public.app_config
  where chave = 'pix_gateway_auth_header';

  select valor
  into v_gateway_auth_prefix
  from public.app_config
  where chave = 'pix_gateway_auth_prefix';

  select valor
  into v_gateway_template
  from public.app_config
  where chave = 'pix_gateway_payload_template';

  select lower(coalesce(valor, 'false')) in ('1','true','yes','on')
  into v_debug
  from public.app_config
  where chave = 'pix_gateway_debug';

  if v_debug is null then
    v_debug := false;
  end if;

  if v_gateway_url is null
     or trim(v_gateway_url) = '' then
    return jsonb_build_object(
      'error',
      'Pagamento Pix ainda não configurado. ' ||
      'Preencha pix_gateway_url e pix_gateway_token em app_config.'
    );
  end if;


  -- ===========================================================
  -- 7) Cria pedido PENDENTE.
  -- ===========================================================

  insert into public.orders (
    customer_id,
    customer_name,
    customer_email,
    items,
    total,
    status,
    anunciante_codigo,
    codigo_afiliado_usado,
    afiliado_id,
    cupom_usado,
    desconto_aplicado,
    cupom_codigo_usado
  )
  values (
    p_customer_id,
    trim(p_name),
    lower(trim(p_email)),
    v_items_reais,
    v_total,
    'PENDENTE',
    v_anunciante_codigo,
    v_codigo_afiliado_usado,
    p_afiliado_id,
    v_cupom_codigo_usado is not null,
    v_desconto,
    v_cupom_codigo_usado
  )
  returning id into v_order_id;


  -- ===========================================================
  -- 8) Monta payload configurável.
  -- ===========================================================

  v_descricao :=
    'Pedido NovaStore #' || v_order_id;

  -- Mercado Pago /v1/payments: payload com os nomes oficiais da API.
  if v_gateway_template is null
     or trim(v_gateway_template) = '' then

    v_gateway_template :=
      '{"transaction_amount":{{valor_json}},' ||
      '"description":{{descricao_json}},' ||
      '"external_reference":{{order_id_json}},' ||
      '"payment_method_id":"pix",' ||
      '"payer":{"email":{{email_json}}}}';
  end if;

  v_gateway_payload_text := v_gateway_template;

  -- Placeholders JSON-safe.
  v_gateway_payload_text :=
    replace(
      v_gateway_payload_text,
      '{{valor_json}}',
      to_jsonb(v_total)::text
    );

  v_gateway_payload_text :=
    replace(
      v_gateway_payload_text,
      '{{descricao_json}}',
      to_jsonb(v_descricao)::text
    );

  v_gateway_payload_text :=
    replace(
      v_gateway_payload_text,
      '{{order_id_json}}',
      to_jsonb(v_order_id::text)::text
    );

  v_gateway_payload_text :=
    replace(
      v_gateway_payload_text,
      '{{nome_json}}',
      to_jsonb(trim(p_name))::text
    );

  v_gateway_payload_text :=
    replace(
      v_gateway_payload_text,
      '{{email_json}}',
      to_jsonb(lower(trim(p_email)))::text
    );

  -- Placeholders numéricos / texto.
  v_gateway_payload_text :=
    replace(
      v_gateway_payload_text,
      '{{valor}}',
      to_char(v_total, 'FM999999990.00')
    );

  v_gateway_payload_text :=
    replace(
      v_gateway_payload_text,
      '{{valor_centavos}}',
      round(v_total * 100)::bigint::text
    );

  v_gateway_payload_text :=
    replace(
      v_gateway_payload_text,
      '{{order_id}}',
      v_order_id::text
    );

  begin
    v_gateway_payload :=
      v_gateway_payload_text::jsonb;
  exception
    when others then

      update public.orders
      set status = 'CANCELADO'
      where id = v_order_id;

      perform public.registrar_pix_gateway_log(
        v_order_id,
        jsonb_build_object(
          'valor', v_total,
          'template', left(v_gateway_template, 8000)
        ),
        null,
        'Template de payload inválido: ' || sqlerrm
      );

      return jsonb_build_object(
        'error',
        'A configuração do corpo do gateway Pix está inválida.',
        'orderId', v_order_id
      );
  end;


  -- ===========================================================
  -- 9) Chamada HTTP.
  -- ===========================================================

  v_gateway_body_text := null;

  begin

    select *
    into v_http_response
    from extensions.http(
      (
        'POST',
        v_gateway_url,
        ARRAY[
          extensions.http_header(
            coalesce(
              nullif(trim(v_gateway_auth_header), ''),
              'Authorization'
            ),
            coalesce(v_gateway_auth_prefix, 'Bearer ') ||
            v_gateway_token
          ),
          extensions.http_header(
            'Accept',
            'application/json'
          ),
          extensions.http_header(
            'X-Idempotency-Key',
            gen_random_uuid()::text
          )
        ],
        'application/json',
        v_gateway_payload::text
      )::extensions.http_request
    );

  exception
    when others then

      -- Falhou antes de receber HTTP.
      if v_cupom_codigo_usado is not null then
        update public.cupons
        set
          usos_atual = greatest(coalesce(usos_atual, 0) - 1, 0),
          usos       = greatest(coalesce(usos, 0) - 1, 0),
          updated_at = now()
        where codigo = v_cupom_codigo_usado;
      end if;

      update public.orders
      set status = 'CANCELADO'
      where id = v_order_id;

      perform public.registrar_pix_gateway_log(
        v_order_id,
        jsonb_build_object(
          'valor', v_total,
          'orderId', v_order_id
        ),
        null,
        'Exceção na chamada HTTP: ' || sqlerrm
      );

      if v_debug then
        return jsonb_build_object(
          'error',
          'Não foi possível conectar ao gateway de pagamento.',
          'orderId', v_order_id,
          'debug', sqlerrm
        );
      end if;

      return jsonb_build_object(
        'error',
        'Não foi possível conectar ao gateway de pagamento.',
        'orderId', v_order_id
      );
  end;


  v_gateway_body_text :=
    left(
      coalesce(v_http_response.content, ''),
      12000
    );


  perform public.registrar_pix_gateway_log(
    v_order_id,
    jsonb_build_object(
      'valor', v_total,
      'orderId', v_order_id
    ),
    v_http_response.status,
    v_gateway_body_text
  );


  -- ===========================================================
  -- 10) HTTP != 2xx
  -- ===========================================================

  if v_http_response.status not between 200 and 299 then

    if v_cupom_codigo_usado is not null then
      update public.cupons
      set
        usos_atual = greatest(coalesce(usos_atual, 0) - 1, 0),
        usos       = greatest(coalesce(usos, 0) - 1, 0),
        updated_at = now()
      where codigo = v_cupom_codigo_usado;
    end if;

    update public.orders
    set status = 'CANCELADO'
    where id = v_order_id;

    if v_debug then
      return jsonb_build_object(
        'error',
        'O gateway de pagamento recusou a cobrança (HTTP ' ||
        v_http_response.status || ').',
        'orderId', v_order_id,
        'gatewayStatus', v_http_response.status,
        'debug', v_gateway_body_text
      );
    end if;

    return jsonb_build_object(
      'error',
      'O gateway de pagamento recusou a cobrança (HTTP ' ||
      v_http_response.status || ').',
      'orderId', v_order_id,
      'gatewayStatus', v_http_response.status
    );
  end if;


  -- ===========================================================
  -- 11) Interpreta resposta JSON do gateway.
  --      Aceita vários formatos comuns sem obrigar o site a
  --      conhecer o formato interno da API.
  -- ===========================================================

  begin
    v_gateway_body :=
      v_http_response.content::jsonb;
  exception
    when others then

      update public.orders
      set status = 'CANCELADO'
      where id = v_order_id;

      if v_cupom_codigo_usado is not null then
        update public.cupons
        set
          usos_atual = greatest(coalesce(usos_atual, 0) - 1, 0),
          usos       = greatest(coalesce(usos, 0) - 1, 0),
          updated_at = now()
        where codigo = v_cupom_codigo_usado;
      end if;

      if v_debug then
        return jsonb_build_object(
          'error',
          'O gateway respondeu, mas não retornou JSON válido.',
          'orderId', v_order_id,
          'gatewayStatus', v_http_response.status,
          'debug', v_gateway_body_text
        );
      end if;

      return jsonb_build_object(
        'error',
        'O gateway respondeu em formato inválido.',
        'orderId', v_order_id
      );
  end;


  -- QR base64: raiz -> data -> pix -> MP-like path.
  v_pix_qrcode_base64 :=
    coalesce(
      v_gateway_body->>'qr_code_base64',
      v_gateway_body->>'qrCodeBase64',
      v_gateway_body->'data'->>'qr_code_base64',
      v_gateway_body->'data'->>'qrCodeBase64',
      v_gateway_body->'pix'->>'qr_code_base64',
      v_gateway_body->'pix'->>'qrCodeBase64',
      v_gateway_body#>>'{point_of_interaction,transaction_data,qr_code_base64}'
    );

  -- Copia e cola: raiz -> data -> pix -> payload/qrCode.
  v_pix_copia_cola :=
    coalesce(
      v_gateway_body->>'qr_code',
      v_gateway_body->>'qrCode',
      v_gateway_body->>'payload',
      v_gateway_body->'data'->>'qr_code',
      v_gateway_body->'data'->>'qrCode',
      v_gateway_body->'data'->>'payload',
      v_gateway_body->'pix'->>'qr_code',
      v_gateway_body->'pix'->>'qrCode',
      v_gateway_body->'pix'->>'payload',
      v_gateway_body#>>'{point_of_interaction,transaction_data,qr_code}'
    );

  -- TXID / ID de cobrança.
  v_pix_txid :=
    coalesce(
      v_gateway_body->>'txid',
      v_gateway_body->>'transaction_id',
      v_gateway_body->>'id',
      v_gateway_body->'data'->>'txid',
      v_gateway_body->'data'->>'transaction_id',
      v_gateway_body->'data'->>'id',
      v_gateway_body->'pix'->>'txid'
    );

  -- Expiração aceita ISO/timestamp quando o gateway oferece.
  begin
    v_pix_expira :=
      nullif(
        coalesce(
          v_gateway_body->>'date_of_expiration',
          v_gateway_body->>'expires_at',
          v_gateway_body->>'expiresAt',
          v_gateway_body->'data'->>'date_of_expiration',
          v_gateway_body->'data'->>'expires_at',
          v_gateway_body->'data'->>'expiresAt',
          v_gateway_body->'pix'->>'date_of_expiration',
          v_gateway_body->'pix'->>'expires_at'
        ),
        ''
      )::timestamptz;
  exception
    when others then
      v_pix_expira := null;
  end;


  -- Alguns gateways retornam somente um payload Pix, sem imagem Base64.
  if v_pix_qrcode_base64 is null
     and v_pix_copia_cola is null
     and v_pix_txid is null then

    update public.orders
    set status = 'CANCELADO'
    where id = v_order_id;

    if v_cupom_codigo_usado is not null then
      update public.cupons
      set
        usos_atual = greatest(coalesce(usos_atual, 0) - 1, 0),
        usos       = greatest(coalesce(usos, 0) - 1, 0),
        updated_at = now()
      where codigo = v_cupom_codigo_usado;
    end if;

    if v_debug then
      return jsonb_build_object(
        'error',
        'O gateway respondeu 2xx, mas não devolveu um QR Code/txid reconhecível.',
        'orderId', v_order_id,
        'gatewayStatus', v_http_response.status,
        'debug', v_gateway_body_text
      );
    end if;

    return jsonb_build_object(
      'error',
      'O gateway respondeu sem os dados necessários para o Pix.',
      'orderId', v_order_id
    );
  end if;


  -- ===========================================================
  -- 12) Salva dados Pix.
  -- ===========================================================

  update public.orders
  set
    pix_qrcode_base64 = v_pix_qrcode_base64,
    pix_copia_cola    = v_pix_copia_cola,
    pix_txid          = v_pix_txid,
    pix_expires_at    = coalesce(
      v_pix_expira,
      now() + interval '30 minutes'
    )
  where id = v_order_id;


  return jsonb_build_object(
    'orderId',
    v_order_id,
    'qrCodeBase64',
    v_pix_qrcode_base64,
    'qrCode',
    v_pix_copia_cola,
    'expiresAt',
    coalesce(
      v_pix_expira,
      now() + interval '30 minutes'
    )
  );
end;
$$;


