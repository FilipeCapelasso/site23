-- =============================================================================
-- NOVASTORE — SUPABASE SUPREMO / UNIFICADO (VERSÃO ORGANIZADA)
-- =============================================================================
-- USO
--   Cole ESTE ARQUIVO INTEIRO no SQL Editor do Supabase e clique em Run.
--   É idempotente: pode rodar de novo a qualquer momento sem duplicar nada
--   e sem apagar dados. A última consulta (seção 22) mostra OK/FALTANDO.
--
-- O QUE ESTE ARQUIVO CONTÉM
--    0  Extensão http
--    1  Tabelas
--    2  Migrações aditivas (bancos já existentes)
--    3  Compatibilidade do admin_activity_log
--    4  Configuração do gateway Pix (Mercado Pago) e do app
--   4A  Limpeza de RPCs antigas (evita erro 42P13)
--    5  Funções auxiliares (is_admin, código de cliente)
--    6  Triggers
--    7  Índices
--    8  Row Level Security (políticas)
--    9  Cupons (validar_cupom)
--   10  Log do gateway
--   11  Confirmação de pagamento
--   12  Checkout Pix (criar_pix_v2)
--   13  criar_pix (compatibilidade)
--   14  Status do pedido
--   15  Sorteio (lista pública, lista do admin, ganhador)
--   16  Log de atividade do admin
--   17  Diagnóstico do Pix
--   18  Storage (buckets e políticas)
--   19  Realtime
--   20  Permissões finais das RPCs
--   21  Dados iniciais
--   22  Verificação final (rode e confira: tudo deve dizer OK)
--   A/B/C  Anexos opcionais (admin, token do gateway, cupom) — comentados
--
-- DEPOIS DE RODAR, FAÇA SÓ ISTO (uma vez):
--   1) Anexo A: torne seu e-mail admin.
--   2) Anexo B: cole o token do Mercado Pago (app_config.pix_gateway_token).
--
-- SOBRE O SORTEIO
--   Só entra no sorteio quem tem conta cadastrada (profiles, com e-mail e
--   nome) e ao menos um pedido PAGO com total > 0. O admin gira apenas
--   sobre essa lista (sorteio_listar_participantes) e o ganhador só é aceito
--   se passar na mesma regra (sorteio_definir_ganhador). Participantes de
--   "exemplo" exibidos no site são só visuais, vivem no index.html e não
--   existem no banco.
-- =============================================================================

-- =============================================================================
-- 0. EXTENSÃO HTTP
-- =============================================================================

create extension if not exists http with schema extensions;


