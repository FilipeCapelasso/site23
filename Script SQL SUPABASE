-- =============================================================================
-- 9. FUNÇÃO DE NORMALIZAÇÃO / VALIDAÇÃO DE CUPOM
-- =============================================================================

create or replace function public.validar_cupom(
  p_codigo text,
  p_subtotal numeric
)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_cupom public.cupons;
  v_subtotal numeric(10,2) := round(coalesce(p_subtotal, 0), 2);
  v_desconto numeric(10,2);
begin
  if auth.uid() is null then
    return jsonb_build_object(
      'valido', false,
      'erro', 'Faça login para validar um cupom.'
    );
  end if;

  if p_codigo is null or trim(p_codigo) = '' then
    return jsonb_build_object(
      'valido', false,
      'erro', 'Informe um código de cupom.'
    );
  end if;

  select *
  into v_cupom
  from public.cupons
  where upper(trim(codigo)) = upper(trim(p_codigo))
  limit 1;

  if not found then
    return jsonb_build_object(
      'valido', false,
      'erro', 'Cupom não encontrado.'
    );
  end if;

  if coalesce(v_cupom.ativo, true) is not true then
    return jsonb_build_object(
      'valido', false,
      'erro', 'Este cupom não está mais ativo.'
    );
  end if;

  if v_cupom.expira_em is not null
     and v_cupom.expira_em < current_date then
    return jsonb_build_object(
      'valido', false,
      'erro', 'Este cupom expirou.'
    );
  end if;

  if v_cupom.limite_uso is not null
     and coalesce(v_cupom.usos_atual, 0) >= v_cupom.limite_uso then
    return jsonb_build_object(
      'valido', false,
      'erro', 'Este cupom já atingiu o limite de usos.'
    );
  end if;

  if v_subtotal < coalesce(v_cupom.valor_minimo_compra, 0) then
    return jsonb_build_object(
      'valido', false,
      'erro',
      'Esse cupom vale a partir de ' ||
      to_char(coalesce(v_cupom.valor_minimo_compra, 0), 'FM999990.00') ||
      '.'
    );
  end if;

  if v_cupom.tipo_desconto = 'percentual' then
    v_desconto := round(
      v_subtotal * (coalesce(v_cupom.valor, 0) / 100.0),
      2
    );
  else
    v_desconto := least(
      coalesce(v_cupom.valor, 0),
      v_subtotal
    );
  end if;

  return jsonb_build_object(
    'valido', true,
    'codigo', v_cupom.codigo,
    'tipo_desconto', v_cupom.tipo_desconto,
    'valor', v_cupom.valor,
    'desconto', v_desconto
  );
end;
$$;


