returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_nome text;
begin
  if not public.is_admin() then
    raise exception 'Apenas administradores podem definir o ganhador.';
  end if;

  select full_name into v_nome from public.profiles where codigo_cliente = p_codigo;
  if v_nome is null then
    return jsonb_build_object('error', 'Cliente com esse código não encontrado.');
  end if;

  update public.sorteios
  set ganhador_nome = v_nome, ganhador_codigo = p_codigo, status = 'finalizado'
  where id = p_sorteio_id;

  return jsonb_build_object('ok', true);
end;
$$;

