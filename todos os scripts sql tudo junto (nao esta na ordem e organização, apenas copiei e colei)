-- ---------------------------------------------------------------------------
-- 7.3 confirmar_pagamento_pix — chame esta função a partir do WEBHOOK do seu
-- gateway de pagamento (numa Supabase Edge Function, usando a service_role
-- key) assim que o Pix cair. Ela marca o pedido como PAGO, baixa o estoque
-- de produtos UNICO e credita comissão de anunciante/afiliado.
-- ---------------------------------------------------------------------------
create or replace function public.confirmar_pagamento_pix(p_order_id uuid, p_txid text default null)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_order         public.orders;
  v_item          jsonb;
  v_comissao_pct  numeric;
  v_anunciante_id uuid;
begin
  select * into v_order from public.orders where id = p_order_id for update;
  if not found then
    return jsonb_build_object('error', 'Pedido não encontrado.');
  end if;
  if v_order.status = 'PAGO' then
    return jsonb_build_object('ok', true, 'already', true);
  end if;

  update public.orders
  set status = 'PAGO', paid_at = now(), pix_txid = coalesce(p_txid, pix_txid)
  where id = p_order_id;

  -- baixa de estoque para produtos do tipo UNICO com estoque controlado
  for v_item in select * from jsonb_array_elements(v_order.items) loop
    update public.products
    set stock = greatest(stock - coalesce((v_item->>'quantity')::int, 1), 0)
    where id = (v_item->>'productId')::uuid
      and type = 'UNICO'
      and stock is not null;
  end loop;

  -- registra a venda pro anunciante (código #0000 cadastrado manualmente)
  if v_order.anunciante_codigo is not null then
    select id into v_anunciante_id from public.anunciantes where codigo = v_order.anunciante_codigo;
    if v_anunciante_id is not null then
      update public.anunciantes set total_vendas = total_vendas + 1 where id = v_anunciante_id;
      insert into public.historico_vendas_anunciantes (anunciante_id, order_id, produto_nome, valor_compra, cliente_nome)
      values (
        v_anunciante_id, v_order.id,
        (select string_agg(it->>'name', ', ') from jsonb_array_elements(v_order.items) it),
        v_order.total, v_order.customer_name
      );
    end if;
  end if;

  -- credita comissão pro cliente afiliado
  if v_order.afiliado_id is not null then
    select coalesce(valor::numeric, 10) into v_comissao_pct
    from public.app_config where chave = 'afiliado_comissao_percentual';

    insert into public.afiliados_indicacoes (afiliado_id, cliente_id, order_id, valor_venda, comissao, status)
    values (
      v_order.afiliado_id, v_order.customer_id, v_order.id, v_order.total,
      round(v_order.total * (coalesce(v_comissao_pct, 10) / 100.0), 2), 'pendente'
    );
  end if;

  return jsonb_build_object('ok', true);
end;
$$;

-- Só o backend (service_role, via Edge Function do webhook) pode chamar isso —
-- de propósito NÃO liberamos para "authenticated", pra ninguém conseguir se
-- auto-confirmar um pedido como pago.
revoke all on function public.confirmar_pagamento_pix(uuid, text) from public, anon, authenticated;
grant execute on function public.confirmar_pagamento_pix(uuid, text) to service_role;

