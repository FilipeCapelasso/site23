-- =====================================================================================
-- PARTE 0 — EXTENSÕES
-- =====================================================================================
-- gen_random_uuid() já é nativo do Postgres 13+ (usado pelo Supabase), não precisa
-- de pgcrypto. A extensão "http" é usada pela função criar_pix() para chamar o
-- gateway de pagamento Pix diretamente do banco.
create extension if not exists http with schema extensions;


