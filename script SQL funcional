returns table(nome text, codigo_cliente text)
language plpgsql
security definer
set search_path = public
as $$
begin
  if not public.is_admin() then
    raise exception 'Apenas administradores podem listar participantes.';
  end if;

  return query
    select distinct p.full_name, p.codigo_cliente
    from public.profiles p
    join public.orders o on o.customer_id = p.id and o.status = 'PAGO'
    where p.codigo_cliente is not null
    order by 1;
end;
