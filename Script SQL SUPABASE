-- =============================================================================
-- 17. DIAGNÓSTICO ADMIN DO PIX
-- =============================================================================
-- Não retorna token. Útil para confirmar rapidamente:
--   - URL configurada
--   - debug ligado/desligado
--   - template
--   - últimos erros HTTP.
--
-- Uso no SQL Editor, logado como admin:
--   select public.diagnostico_pix_novastore();

create or replace function public.diagnostico_pix_novastore()
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_url text;
  v_token text;
  v_debug text;
  v_template text;
  v_logs jsonb;
begin
  if not public.is_admin() then
    raise exception 'Apenas administradores podem consultar o diagnóstico.';
  end if;

  select valor into v_url
  from public.app_config
  where chave = 'pix_gateway_url';

  select valor into v_token
  from public.app_config
  where chave = 'pix_gateway_token';

  select valor into v_debug
  from public.app_config
  where chave = 'pix_gateway_debug';

  select valor into v_template
  from public.app_config
  where chave = 'pix_gateway_payload_template';

  select coalesce(
    jsonb_agg(
      jsonb_build_object(
        'created_at', l.created_at,
        'order_id', l.order_id,
        'http_status', l.http_status,
        'request_summary', l.request_summary,
        'response_body', left(coalesce(l.response_body, ''), 4000)
      )
      order by l.created_at desc
    ),
    '[]'::jsonb
  )
  into v_logs
  from (
    select *
    from public.pix_gateway_logs
    order by created_at desc
    limit 10
  ) l;

  return jsonb_build_object(
    'gateway_url_configurado',
    coalesce(v_url, '') <> '',
    'gateway_url',
    v_url,
    'gateway_token_configurado',
    coalesce(v_token, '') <> '',
    'debug',
    lower(coalesce(v_debug, 'false')) in ('1','true','yes','on'),
    'payload_template',
    v_template,
    'ultimos_logs',
    v_logs
  );
end;
$$;

