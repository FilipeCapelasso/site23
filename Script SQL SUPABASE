to authenticated;


-- ---------------------------------------------------------------------------
-- Lista pública real de participantes
-- ---------------------------------------------------------------------------
-- Regra: somente clientes com pelo menos um pedido PAGO e total > 0.
-- Privacidade: nunca retorna e-mail, telefone ou nome completo.
-- O nome é reduzido para "Primeiro N." quando houver sobrenome.
-- O código do cliente é mantido porque o site o utiliza como código de sorteio.

create or replace function public.sorteio_listar_participantes_publico()
returns table(
  nome_exibicao   text,
  codigo_cliente  text,
  entrou_em       timestamptz,
  total_gasto     numeric
)
language sql
stable
security definer
set search_path = public
as $$
  select
    case
      when p.full_name is null or btrim(p.full_name) = ''
        then 'Cliente NovaStore'
      when strpos(btrim(p.full_name), ' ') = 0
        then btrim(p.full_name)
      else
        split_part(btrim(p.full_name), ' ', 1)
        || ' '
        || left(split_part(btrim(p.full_name), ' ', 2), 1)
        || '.'
    end as nome_exibicao,
    p.codigo_cliente,
    max(o.created_at) as entrou_em,
    -- Só o degrau do nível (0/200/500/1500), usado pelo selo Bronze/Silver/
    -- Gold/Diamond. O valor gasto exato nunca é exposto publicamente.
    (case
       when sum(o.total) >= 1500 then 1500
       when sum(o.total) >= 500  then 500
       when sum(o.total) >= 200  then 200
       else 0
     end)::numeric as total_gasto
  from public.profiles p
  join public.orders o
    on o.customer_id = p.id
   and o.status = 'PAGO'
   and o.total > 0
  where p.codigo_cliente is not null
  group by p.id, p.full_name, p.codigo_cliente
  order by entrou_em desc;
$$;

