create or replace function public.set_updated_at()
returns trigger
language plpgsql
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;


create or replace function public.is_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1
    from public.profiles p
    where p.id = auth.uid()
      and p.role = 'admin'
  );
$$;


create or replace function public.gerar_codigo_4_digitos()
returns text
language sql
as $$
  select '#' || lpad((floor(random() * 9000) + 1000)::int::text, 4, '0');
$$;


create or replace function public.gerar_codigo_cliente_unico()
returns text
language plpgsql
as $$
declare
  v_codigo text;
  v_tentativas integer := 0;
begin
  loop
    v_codigo := public.gerar_codigo_4_digitos();
    v_tentativas := v_tentativas + 1;

    exit when not exists (
      select 1
      from public.profiles
      where codigo_cliente = v_codigo
    );

    if v_tentativas >= 50 then
      raise exception 'Não foi possível gerar um código de cliente único.';
    end if;
  end loop;

  return v_codigo;
end;
$$;


