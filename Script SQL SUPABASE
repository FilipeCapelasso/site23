-- Normaliza defaults/valores ausentes na tabela cupons antiga.
update public.cupons
set
  tipo_desconto       = coalesce(nullif(tipo_desconto, ''), nullif(tipo, ''), 'percentual'),
  valor_minimo_compra = coalesce(valor_minimo_compra, valor_minimo, 0),
  usos_atual          = coalesce(usos_atual, usos, 0),
  ativo               = coalesce(ativo, true),
  created_at          = coalesce(created_at, now()),
  updated_at          = coalesce(updated_at, now())
