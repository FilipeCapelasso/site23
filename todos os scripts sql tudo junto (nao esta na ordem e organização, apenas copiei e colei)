-- =====================================================================================

-- Verifica se o usuário autenticado atual é admin (usada em quase toda política RLS)
create or replace function public.is_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.profiles p
    where p.id = auth.uid() and p.role = 'admin'
  );
$$;

-- Trigger genérica que mantém a coluna updated_at sempre atualizada
create or replace function public.set_updated_at()
returns trigger
language plpgsql
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

-- Gera um código no formato oficial da loja: "#" + 4 dígitos (ex: #4827)
create or replace function public.gerar_codigo_4_digitos()
returns text
language sql
as $$
  select '#' || lpad((floor(random() * 9000) + 1000)::int::text, 4, '0');
$$;

-- Gera um código de CLIENTE (usado no sorteio) garantindo que seja único
-- dentro da própria tabela profiles.
create or replace function public.gerar_codigo_cliente_unico()
returns text
language plpgsql
as $$
declare
  v_codigo text;
  v_tentativas int := 0;
begin
  loop
    v_codigo := public.gerar_codigo_4_digitos();
    v_tentativas := v_tentativas + 1;
    exit when not exists (select 1 from public.profiles where codigo_cliente = v_codigo);
    exit when v_tentativas >= 30;
  end loop;
  return v_codigo;
end;
$$;


