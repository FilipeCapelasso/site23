create or replace function public.sorteio_definir_ganhador(
  p_sorteio_id uuid,
  p_codigo text
)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_nome text;
begin
  if not public.is_admin() then
    raise exception 'Apenas administradores podem definir o ganhador.';
  end if;

  select p.full_name
  into v_nome
  from public.profiles p
  where p.codigo_cliente = p_codigo
    and exists (
      select 1
      from public.orders o
      where o.customer_id = p.id
        and o.status = 'PAGO'
        and o.total > 0
    )
  limit 1;

  if v_nome is null then
    return jsonb_build_object(
      'error',
      'Cliente com esse código não é um participante elegível do sorteio.'
    );
  end if;

  update public.sorteios
  set
    ganhador_nome = v_nome,
    ganhador_codigo = p_codigo,
    status = 'finalizado'
  where id = p_sorteio_id;

  return jsonb_build_object(
    'ok', true
  );
end;
$$;

