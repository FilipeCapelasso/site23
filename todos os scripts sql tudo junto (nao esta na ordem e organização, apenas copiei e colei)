-- Rode este script no SQL Editor do Supabase (Database > SQL Editor)
-- Ele adiciona a coluna "images" (lista de URLs) na tabela "products",
-- sem afetar a coluna "image_url" que já existe (ela continua sendo
-- a imagem principal/capa usada nos cards da loja).

alter table public.products
  add column if not exists images jsonb not null default '[]'::jsonb;

-- Opcional, mas recomendado: migra os produtos já cadastrados,
-- colocando a imagem principal atual dentro do novo array "images"
-- (assim eles já aparecem com pelo menos 1 imagem na galeria).
update public.products
set images = jsonb_build_array(image_url)
where images = '[]'::jsonb
  and image_url is not null;

-- =====================================================================================
-- PATCH — criar_pix_v2: libera pedidos com total R$ 0,00 sem passar pelo gateway Pix
--
-- PROBLEMA: mesmo um produto configurado como grátis (price = 0) chegava ao final
-- do carrinho com v_total forçado pra no mínimo R$ 0,01 (por causa do
-- "greatest(..., 0.01)"), e a função tentava gerar uma cobrança Pix de verdade —
-- que o gateway recusa (HTTP 400) porque o valor é baixo/inconsistente.
--
-- SOLUÇÃO: se o total do pedido (subtotal - desconto) for menor ou igual a zero,
-- a função:
--   1. Salva o pedido normalmente (pra manter histórico, comissão de afiliado etc.)
--   2. Chama public.confirmar_pagamento_pix(v_order_id) diretamente — a mesma
--      função que o webhook do Pix chamaria — o que já marca o pedido como PAGO,
--      dá baixa de estoque (se aplicável) e credita comissão de afiliado/anunciante.
--   3. Retorna { orderId, free: true } SEM tentar chamar o gateway HTTP.
-- Pedidos com total > 0 continuam exatamente como antes (Pix normal).
--
-- Assinatura da função é mantida idêntica — não precisa mudar nada na chamada
-- supabase.rpc("criar_pix_v2", {...}) feita pelo front, só tratar o novo campo
-- opcional "free" no retorno (isso já foi feito no index.html).
-- =====================================================================================

create or replace function public.criar_pix_v2(
  p_name              text,
  p_email             text,
  p_items             jsonb,
  p_customer_id       uuid default null,
  p_anunciante_codigo text default null,
  p_afiliado_id       uuid default null,
  p_cupom_codigo      text default null
)
returns jsonb
language plpgsql
security definer
set search_path = public, extensions
as $$
declare
  v_subtotal              numeric(10,2) := 0;
  v_desconto              numeric(10,2) := 0;
  v_total                 numeric(10,2) := 0;
  v_tem_codigo            boolean := false;
  v_codigo_afiliado_usado text := null;
  v_anunciante_codigo     text := null;
  v_order_id              uuid;
  v_item                  jsonb;
  v_items_reais           jsonb := '[]'::jsonb;
  v_product               public.products;
  v_product_id            uuid;
  v_quantity              integer;
  v_plan_id               integer;
  v_plan                  jsonb;
  v_item_price            numeric(10,2);
  v_item_plan_name        text;
  v_gateway_url           text;
  v_gateway_token         text;
  v_http_response         http_response;
  v_gateway_body          jsonb;
  v_pix_qrcode_base64     text;
  v_pix_copia_cola        text;
  v_pix_txid              text;
  v_pix_expira            timestamptz;
  v_desconto_minimo       numeric := 80;
  v_max_qtd_item          constant integer := 20;
  v_cupom                 public.cupons;
  v_cupom_codigo_usado    text := null;
  v_total_bruto           numeric(10,2) := 0; -- subtotal - desconto, ANTES do piso de R$0,01
  v_confirm               jsonb;
begin
  if p_items is null or jsonb_array_length(p_items) = 0 then
    return jsonb_build_object('error', 'Carrinho vazio.');
  end if;

  -- =====================================================================
  -- O BANCO É A FONTE DE VERDADE DO PREÇO (idêntico à versão anterior).
  -- =====================================================================
  for v_item in select * from jsonb_array_elements(p_items) loop
    begin
      v_product_id := (v_item->>'productId')::uuid;
    exception when others then
      return jsonb_build_object('error', 'Item do carrinho inválido.');
    end;

    begin
      v_quantity := floor(coalesce((v_item->>'quantity')::numeric, 0))::integer;
    exception when others then
      return jsonb_build_object('error', 'Quantidade inválida para um dos itens.');
    end;
    if v_quantity is null or v_quantity <= 0 then
      return jsonb_build_object('error', 'Quantidade inválida para um dos itens.');
    end if;
    if v_quantity > v_max_qtd_item then
      return jsonb_build_object('error', 'Quantidade muito alta para um único item (máximo ' || v_max_qtd_item || ' por item).');
    end if;

    select * into v_product from public.products where id = v_product_id;
    if not found then
      return jsonb_build_object('error', 'Um dos produtos do carrinho não existe mais.');
    end if;
    if not v_product.active then
      return jsonb_build_object('error', 'O produto "' || v_product.name || '" não está mais disponível.');
    end if;

    v_plan_id := null;
    v_item_plan_name := null;

    if v_product.type = 'ASSINATURA' then
      if v_item->>'planId' is null then
        return jsonb_build_object('error', 'Selecione um plano para "' || v_product.name || '".');
      end if;
      begin
        v_plan_id := (v_item->>'planId')::integer;
      exception when others then
        return jsonb_build_object('error', 'Plano inválido para "' || v_product.name || '".');
      end;
      if v_plan_id < 0 or v_plan_id >= jsonb_array_length(coalesce(v_product.plans, '[]'::jsonb)) then
        return jsonb_build_object('error', 'Plano inválido para "' || v_product.name || '".');
      end if;
      v_plan := v_product.plans -> v_plan_id;
      if v_plan is null or v_plan->>'price' is null then
        return jsonb_build_object('error', 'Plano sem preço configurado para "' || v_product.name || '".');
      end if;
      v_item_price := (v_plan->>'price')::numeric(10,2);
      v_item_plan_name := v_plan->>'name';
    else
      if v_product.price is null then
        return jsonb_build_object('error', 'Produto "' || v_product.name || '" está sem preço configurado.');
      end if;
      v_item_price := v_product.price;
      if v_product.stock is not null and v_product.stock < v_quantity then
        return jsonb_build_object('error', 'Estoque insuficiente para "' || v_product.name || '".');
      end if;
    end if;

    v_subtotal := v_subtotal + (v_item_price * v_quantity);

    v_items_reais := v_items_reais || jsonb_build_array(jsonb_build_object(
      'productId', v_product_id,
      'planId',    v_plan_id,
      'name',      v_product.name,
      'planName',  v_item_plan_name,
      'price',     v_item_price,
      'quantity',  v_quantity
    ));
  end loop;

  -- valida código de anunciante OU de afiliado (guardado no pedido pra dar
  -- comissão, mesmo que o desconto final venha do cupom)
  if p_anunciante_codigo is not null then
    select codigo into v_anunciante_codigo from public.anunciantes where codigo = p_anunciante_codigo;
    if v_anunciante_codigo is not null then v_tem_codigo := true; end if;
  end if;

  if not v_tem_codigo and p_afiliado_id is not null then
    select codigo_afiliado into v_codigo_afiliado_usado
    from public.profiles
    where id = p_afiliado_id and is_afiliado = true;
    if v_codigo_afiliado_usado is not null then v_tem_codigo := true; end if;
  end if;

  if v_tem_codigo and v_subtotal >= v_desconto_minimo then
    v_desconto := round(v_subtotal * 0.10, 2);
  end if;

  -- ---------------------------------------------------------------------
  -- CUPOM PROMOCIONAL: se um código válido for enviado, o desconto dele
  -- SUBSTITUI o desconto de indicação calculado acima (não acumulam).
  -- ---------------------------------------------------------------------
  if p_cupom_codigo is not null and trim(p_cupom_codigo) <> '' then
    select * into v_cupom from public.cupons where upper(codigo) = upper(trim(p_cupom_codigo)) for update;

    if not found then
      return jsonb_build_object('error', 'Cupom não encontrado.');
    end if;
    if not v_cupom.ativo then
      return jsonb_build_object('error', 'Este cupom não está mais ativo.');
    end if;
    if v_cupom.expira_em is not null and v_cupom.expira_em < current_date then
      return jsonb_build_object('error', 'Este cupom expirou.');
    end if;
    if v_cupom.limite_uso is not null and v_cupom.usos_atual >= v_cupom.limite_uso then
      return jsonb_build_object('error', 'Este cupom já atingiu o limite de usos.');
    end if;
    if v_subtotal < v_cupom.valor_minimo_compra then
      return jsonb_build_object('error', 'Esse cupom vale a partir de ' || to_char(v_cupom.valor_minimo_compra, 'FM999990.00') || '.');
    end if;

    if v_cupom.tipo_desconto = 'percentual' then
      v_desconto := round(v_subtotal * (v_cupom.valor / 100.0), 2);
    else
      v_desconto := least(v_cupom.valor, v_subtotal);
    end if;

    v_cupom_codigo_usado := v_cupom.codigo;
    v_tem_codigo := true;

    update public.cupons set usos_atual = usos_atual + 1, updated_at = now() where id = v_cupom.id;
  end if;

  -- valor "real" do pedido, antes de qualquer piso mínimo de cobrança
  v_total_bruto := round(v_subtotal - v_desconto, 2);

  -- =====================================================================
  -- PEDIDO GRATUITO (total <= 0): não faz sentido gerar Pix. Salva o
  -- pedido, já libera como PAGO (via confirmar_pagamento_pix, que cuida de
  -- baixa de estoque e comissão) e retorna sem chamar o gateway.
  -- =====================================================================
  if v_total_bruto <= 0 then
    insert into public.orders (
      customer_id, customer_name, customer_email, items, total, status,
      anunciante_codigo, codigo_afiliado_usado, afiliado_id, cupom_usado, desconto_aplicado,
      cupom_codigo_usado
    ) values (
      p_customer_id, p_name, p_email, v_items_reais, 0, 'PENDENTE',
      v_anunciante_codigo, v_codigo_afiliado_usado, p_afiliado_id, v_tem_codigo, v_desconto,
      v_cupom_codigo_usado
    ) returning id into v_order_id;

    -- reaproveita a mesma função que o webhook do Pix chamaria: marca PAGO,
    -- baixa estoque de produtos UNICO e credita comissão de afiliado/anunciante
    v_confirm := public.confirmar_pagamento_pix(v_order_id, null);

    if v_confirm is null or (v_confirm->>'ok') is distinct from 'true' then
      return jsonb_build_object('error', 'Não foi possível liberar o pedido gratuito automaticamente. Fale com o suporte informando o pedido #' || v_order_id || '.');
    end if;

    return jsonb_build_object('orderId', v_order_id, 'free', true);
  end if;

  -- =====================================================================
  -- FLUXO NORMAL (pedido pago via Pix) — igual à versão anterior.
  -- =====================================================================
  v_total := greatest(v_total_bruto, 0.01);

  insert into public.orders (
    customer_id, customer_name, customer_email, items, total, status,
    anunciante_codigo, codigo_afiliado_usado, afiliado_id, cupom_usado, desconto_aplicado,
    cupom_codigo_usado
  ) values (
    p_customer_id, p_name, p_email, v_items_reais, v_total, 'PENDENTE',
    v_anunciante_codigo, v_codigo_afiliado_usado, p_afiliado_id, v_tem_codigo, v_desconto,
    v_cupom_codigo_usado
  ) returning id into v_order_id;

  select valor into v_gateway_url   from public.app_config where chave = 'pix_gateway_url';
  select valor into v_gateway_token from public.app_config where chave = 'pix_gateway_token';

  if v_gateway_url is null or v_gateway_url = '' then
    return jsonb_build_object(
      'error', 'Pagamento Pix ainda não configurado (tabela app_config). O pedido #' || v_order_id || ' foi salvo como pendente.'
    );
  end if;

  begin
    select * into v_http_response from http((
      'POST',
      v_gateway_url,
      array[http_header('Authorization', 'Bearer ' || coalesce(v_gateway_token, ''))],
      'application/json',
      jsonb_build_object(
        'valor', v_total,
        'descricao', 'Pedido NovaStore #' || v_order_id,
        'referencia_externa', v_order_id,
        'pagador', jsonb_build_object('nome', p_name, 'email', p_email)
      )::text
    )::http_request);
  exception when others then
    update public.orders set status = 'CANCELADO' where id = v_order_id;
    return jsonb_build_object('error', 'Não foi possível conectar ao gateway de pagamento.');
  end;

  if v_http_response.status not between 200 and 299 then
    update public.orders set status = 'CANCELADO' where id = v_order_id;
    return jsonb_build_object('error', 'O gateway de pagamento recusou a cobrança (HTTP ' || v_http_response.status || ').');
  end if;

  v_gateway_body := v_http_response.content::jsonb;

  v_pix_qrcode_base64 := v_gateway_body->>'qr_code_base64';
  v_pix_copia_cola    := v_gateway_body->>'qr_code';
  v_pix_txid          := v_gateway_body->>'txid';
  v_pix_expira        := nullif(v_gateway_body->>'expires_at', '')::timestamptz;

  update public.orders set
    pix_qrcode_base64 = v_pix_qrcode_base64,
    pix_copia_cola     = v_pix_copia_cola,
    pix_txid           = v_pix_txid,
    pix_expires_at     = coalesce(v_pix_expira, now() + interval '30 minutes')
  where id = v_order_id;

  return jsonb_build_object(
    'orderId',      v_order_id,
    'qrCodeBase64', v_pix_qrcode_base64,
    'qrCode',       v_pix_copia_cola,
    'expiresAt',    coalesce(v_pix_expira, now() + interval '30 minutes')
  );
end;
$$;

grant execute on function public.criar_pix_v2(text, text, jsonb, uuid, text, uuid, text) to authenticated;

-- =====================================================================================
-- PATCH — sorteio_listar_participantes: pedidos grátis (total = 0) não contam
-- como participação no sorteio de verdade. Como a criar_pix_v2 corrigida acima
-- agora marca pedidos gratuitos como status = 'PAGO' (pra liberar o produto na
-- hora), sem esse ajuste um cliente que só resgatou produtos grátis apareceria
-- como elegível pro sorteio igual quem realmente comprou algo.
-- =====================================================================================
create or replace function public.sorteio_listar_participantes()
returns table(nome text, codigo_cliente text)
language plpgsql
security definer
set search_path = public
as $$
begin
  if not public.is_admin() then
    raise exception 'Apenas administradores podem listar participantes.';
  end if;

  return query
    select distinct p.full_name, p.codigo_cliente
    from public.profiles p
    join public.orders o on o.customer_id = p.id and o.status = 'PAGO' and o.total > 0
    where p.codigo_cliente is not null
    order by 1;
end;
$$;

grant execute on function public.sorteio_listar_participantes() to authenticated;

-- =====================================================================================
--  NOVASTORE — SCRIPT SQL DAS NOVAS FUNCIONALIDADES (Cupons, Avaliações, Atividade,
--  estoque mínimo e meta de vendas)
-- =====================================================================================
--  Este script é 100% ADITIVO: ele só cria tabelas/colunas/políticas NOVAS.
--  Ele NÃO altera, substitui nem remove nada do script principal que já está
--  rodando no seu Supabase (script_SQL_funcional.txt) — pode rodar com segurança,
--  é idempotente (dá pra rodar de novo sem quebrar nada).
--
--  COMO USAR:
--    1. Abra o SQL Editor do seu projeto Supabase.
--    2. Cole o conteúdo INTEIRO deste arquivo e rode de uma vez.
--    3. Pronto — as abas "Cupons", "Avaliações" e "Atividade" do painel admin,
--       o card de "Estoque baixo", a "Meta de vendas do mês" e o sino de
--       notificações passam a funcionar.
--
--  O QUE ESTE SCRIPT CRIA:
--    - 2 colunas novas em site_settings: estoque_minimo, meta_vendas_mensal
--    - Tabela nova: cupons (cadastro de cupons de desconto — só admin usa por
--      enquanto; ver observação importante na PARTE 2 sobre o checkout)
--    - Tabela nova: admin_activity_log (log de auditoria das ações do admin)
--      + função log_admin_activity(...) chamada pelo front-end
--    - 1 política nova na tabela avaliacoes (já existente), permitindo o admin
--      remover avaliações — sem tocar nas 3 políticas que já existem nela
-- =====================================================================================


-- =====================================================================================
-- PARTE 1 — ESTOQUE MÍNIMO E META DE VENDAS (novas colunas em site_settings)
-- =====================================================================================
-- site_settings já existe e já tem RLS + políticas de leitura pública / escrita
-- só de admin — as colunas novas herdam essas mesmas políticas automaticamente,
-- não precisa criar nenhuma política nova aqui.
alter table public.site_settings
  add column if not exists estoque_minimo      integer not null default 5,
  add column if not exists meta_vendas_mensal   numeric(10,2);


-- =====================================================================================
-- PARTE 2 — CUPONS DE DESCONTO
-- =====================================================================================
-- ⚠️ IMPORTANTE: esta tabela cadastra e organiza os cupons (criar, ativar/
-- desativar, ver quantas vezes foi usado, excluir) direto pelo painel admin.
-- Ela NÃO está automaticamente aplicando desconto no checkout Pix, porque isso
-- exigiria alterar a função criar_pix(...) que você pediu para não mexer (ela
-- calcula o total e já cuida do desconto de anunciante/afiliado). Se depois
-- você quiser que o cupom desconte direto na cobrança Pix, me avise que eu
-- preparo o ajuste em uma função nova, sem tocar na criar_pix original.

create table if not exists public.cupons (
  id            uuid primary key default gen_random_uuid(),
  codigo        text not null unique,
  tipo          text not null default 'percentual' check (tipo in ('percentual','fixo')),
  valor         numeric(10,2) not null check (valor > 0),
  valor_minimo  numeric(10,2) not null default 0,
  limite_uso    integer,
  usos          integer not null default 0,
  ativo         boolean not null default true,
  validade      timestamptz,
  created_at    timestamptz not null default now(),
  updated_at    timestamptz not null default now()
);

drop trigger if exists trg_cupons_updated_at on public.cupons;
create trigger trg_cupons_updated_at
  before update on public.cupons
  for each row execute function public.set_updated_at();

create index if not exists idx_cupons_codigo on public.cupons(codigo);
create index if not exists idx_cupons_ativo  on public.cupons(ativo);

alter table public.cupons enable row level security;

-- só o admin consegue ler/criar/editar/excluir cupons pelo painel
drop policy if exists "cupons_admin_all" on public.cupons;
create policy "cupons_admin_all"
  on public.cupons for all
  to authenticated
  using (public.is_admin())
  with check (public.is_admin());


-- =====================================================================================
-- PARTE 3 — LOG DE ATIVIDADE (auditoria do painel admin)
-- =====================================================================================
create table if not exists public.admin_activity_log (
  id            uuid primary key default gen_random_uuid(),
  admin_id      uuid references public.profiles(id) on delete set null,
  admin_name    text,
  acao          text not null,
  detalhes      jsonb not null default '{}'::jsonb,
  created_at    timestamptz not null default now()
);

create index if not exists idx_admin_activity_log_created_at on public.admin_activity_log(created_at desc);

alter table public.admin_activity_log enable row level security;

-- só admin consegue LER o log (a escrita é feita só pela função abaixo,
-- então não existe política de insert direta — evita log falso vindo do cliente)
drop policy if exists "admin_activity_log_select_admin" on public.admin_activity_log;
create policy "admin_activity_log_select_admin"
  on public.admin_activity_log for select
  to authenticated
  using (public.is_admin());

-- função chamada pelo front-end (logAdminActivity) toda vez que o admin faz
-- uma ação nas novas telas (criar/excluir cupom, remover avaliação etc.)
create or replace function public.log_admin_activity(p_acao text, p_detalhes jsonb default '{}'::jsonb)
returns void
language plpgsql
security definer
set search_path = public
as $$
declare
  v_nome text;
begin
  if not public.is_admin() then
    raise exception 'Apenas administradores podem registrar atividade.';
  end if;

  select full_name into v_nome from public.profiles where id = auth.uid();

  insert into public.admin_activity_log (admin_id, admin_name, acao, detalhes)
  values (auth.uid(), coalesce(v_nome, 'Admin'), p_acao, coalesce(p_detalhes, '{}'::jsonb));
end;
$$;

grant execute on function public.log_admin_activity(text, jsonb) to authenticated;


-- =====================================================================================
-- PARTE 4 — MODERAÇÃO DE AVALIAÇÕES (permite o admin remover)
-- =====================================================================================
-- A tabela avaliacoes já existe com 3 políticas (select público, insert do
-- próprio cliente, update do próprio cliente). Esta é uma política ADICIONAL,
-- só de admin, que permite excluir/editar qualquer avaliação — as 3 políticas
-- originais continuam exatamente como estão, não são tocadas.
drop policy if exists "avaliacoes_admin_all" on public.avaliacoes;
create policy "avaliacoes_admin_all"
  on public.avaliacoes for all
  to authenticated
  using (public.is_admin())
  with check (public.is_admin());


-- =====================================================================================
-- NOVAS FUNÇÕES DO ADMIN — script 100% ADITIVO
--
-- Este script NÃO altera, substitui nem apaga nada do script SQL que já está
-- em produção. Ele só:
--   1) cria 2 tabelas novas (cupons, admin_activity_log);
--   2) adiciona 3 colunas novas em tabelas que já existem (orders, site_settings) —
--      "ADD COLUMN IF NOT EXISTS" nunca afeta as colunas/linhas que já existem;
--   3) adiciona 1 política de RLS nova (avaliacoes), sem tocar nas políticas
--      que já existem para avaliacoes;
--   4) cria 2 funções novas (validar_cupom, criar_pix_v2) — a função
--      "criar_pix" original continua existindo, intacta, e sem uso a partir
--      de agora (o site passa a chamar "criar_pix_v2");
--   5) adiciona a tabela "orders" na publicação de realtime (necessário só
--      para o sino de notificações do admin funcionar em tempo real).
--
-- COMO APLICAR: cole este arquivo inteiro no SQL Editor do Supabase e rode.
-- Pode rodar mais de uma vez sem problema (todos os comandos são "idempotentes").
-- =====================================================================================


-- =====================================================================================
-- 1) COLUNAS NOVAS EM TABELAS EXISTENTES (aditivo — não mexe no que já existe)
-- =====================================================================================

-- guarda qual cupom promocional (se algum) foi usado em cada pedido
alter table public.orders
  add column if not exists cupom_codigo_usado text;

-- limite de estoque a partir do qual o produto aparece como "estoque baixo" no admin
alter table public.site_settings
  add column if not exists estoque_baixo_limite integer not null default 3;

-- meta de faturamento do mês, editada na aba Vendas do admin
alter table public.site_settings
  add column if not exists meta_vendas_mensal numeric(10,2);


-- =====================================================================================
-- 2) TABELA NOVA: cupons de desconto promocionais
-- =====================================================================================
create table if not exists public.cupons (
  id                    uuid primary key default gen_random_uuid(),
  codigo                text not null unique,
  tipo_desconto         text not null default 'percentual' check (tipo_desconto in ('percentual','fixo')),
  valor                 numeric(10,2) not null check (valor > 0),
  valor_minimo_compra   numeric(10,2) not null default 0,
  limite_uso            integer,                 -- null = sem limite de usos
  usos_atual            integer not null default 0,
  ativo                 boolean not null default true,
  expira_em             date,                     -- null = sem prazo de validade
  created_at            timestamptz not null default now(),
  updated_at            timestamptz not null default now()
);

create index if not exists cupons_codigo_idx on public.cupons (codigo);

alter table public.cupons enable row level security;

-- só o admin lê/edita a lista de cupons diretamente pela tabela (o cliente nunca
