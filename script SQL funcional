-- 5.3 Impede que um cliente comum promova a si mesmo a admin/afiliado
-- editando o próprio perfil (defesa extra além da política RLS de UPDATE)
create or replace function public.protect_profile_privileged_fields()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  if not public.is_admin() then
    new.role            := old.role;
    new.is_afiliado      := old.is_afiliado;
    new.codigo_afiliado   := old.codigo_afiliado;
    new.codigo_cliente    := old.codigo_cliente;
    new.email            := old.email;
  end if;
  return new;
end;
$$;

drop trigger if exists trg_protect_profile_privileged_fields on public.profiles;
create trigger trg_protect_profile_privileged_fields
  before update on public.profiles
  for each row execute function public.protect_profile_privileged_fields();

-- 5.4 Só deixa avaliar produto que o cliente realmente comprou e pagou
-- (o front-end já esconde o formulário, isso aqui garante no banco)
create or replace function public.enforce_avaliacao_requer_compra()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  if not exists (
    select 1 from public.orders o
    where o.customer_id = new.customer_id
      and o.status = 'PAGO'
      and exists (
        select 1 from jsonb_array_elements(o.items) it
        where (it->>'productId')::uuid = new.product_id
      )
  ) then
    raise exception 'Você só pode avaliar produtos que já comprou.';
  end if;
  return new;
end;
$$;

drop trigger if exists trg_avaliacao_requer_compra on public.avaliacoes;
create trigger trg_avaliacao_requer_compra
  before insert or update on public.avaliacoes
  for each row execute function public.enforce_avaliacao_requer_compra();


-- =====================================================================================
-- PARTE 6 — ROW LEVEL SECURITY (RLS)
-- =====================================================================================

-- ---------- profiles ----------
alter table public.profiles enable row level security;

drop policy if exists "profiles_select_authenticated" on public.profiles;
create policy "profiles_select_authenticated"
  on public.profiles for select
  to authenticated
  using (true); -- nomes/avatares são visíveis entre usuários logados (chat, amigos, busca)

drop policy if exists "profiles_update_self_or_admin" on public.profiles;
create policy "profiles_update_self_or_admin"
  on public.profiles for update
  to authenticated
  using (auth.uid() = id or public.is_admin())
  with check (auth.uid() = id or public.is_admin());

-- ---------- products ----------
alter table public.products enable row level security;

drop policy if exists "products_select_public_active_or_admin" on public.products;
create policy "products_select_public_active_or_admin"
  on public.products for select
  to anon, authenticated
  using (active = true or public.is_admin());

drop policy if exists "products_admin_all" on public.products;
create policy "products_admin_all"
  on public.products for all
  to authenticated
  using (public.is_admin())
  with check (public.is_admin());

-- ---------- orders ----------
alter table public.orders enable row level security;

drop policy if exists "orders_select_own_or_admin" on public.orders;
create policy "orders_select_own_or_admin"
  on public.orders for select
  to authenticated
  using (customer_id = auth.uid() or public.is_admin());

drop policy if exists "orders_admin_update" on public.orders;
create policy "orders_admin_update"
  on public.orders for update
  to authenticated
  using (public.is_admin())
  with check (public.is_admin());

drop policy if exists "orders_admin_delete" on public.orders;
create policy "orders_admin_delete"
  on public.orders for delete
  to authenticated
  using (public.is_admin());
-- Não existe política de INSERT: pedidos só são criados pela função criar_pix()
-- (SECURITY DEFINER), nunca diretamente pelo cliente.

-- ---------- messages ----------
alter table public.messages enable row level security;

drop policy if exists "messages_select_participant_or_admin" on public.messages;
create policy "messages_select_participant_or_admin"
  on public.messages for select
  to authenticated
  using (sender_id = auth.uid() or receiver_id = auth.uid() or public.is_admin());

drop policy if exists "messages_insert_as_self" on public.messages;
create policy "messages_insert_as_self"
  on public.messages for insert
  to authenticated
  with check (
    sender_id = auth.uid()
    and exists (
      select 1 from public.orders o
      where o.id = order_id and (o.customer_id = auth.uid() or public.is_admin())
    )
  );

-- ---------- chat_privado ----------
alter table public.chat_privado enable row level security;

drop policy if exists "chat_privado_select_own_or_admin" on public.chat_privado;
create policy "chat_privado_select_own_or_admin"
  on public.chat_privado for select
  to authenticated
  using (customer_id = auth.uid() or public.is_admin());

drop policy if exists "chat_privado_insert" on public.chat_privado;
create policy "chat_privado_insert"
  on public.chat_privado for insert
  to authenticated
  with check (sender_id = auth.uid() and (customer_id = auth.uid() or public.is_admin()));

drop policy if exists "chat_privado_update_read" on public.chat_privado;
create policy "chat_privado_update_read"
  on public.chat_privado for update
  to authenticated
  using (customer_id = auth.uid() or public.is_admin())
  with check (customer_id = auth.uid() or public.is_admin());

