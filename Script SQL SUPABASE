-- =============================================================================
-- 3. COMPATIBILIDADE DE admin_activity_log
-- =============================================================================
-- Uma versão antiga criou detalhes como jsonb; o front atual envia texto.
-- Converte somente quando a coluna realmente estiver em jsonb.

do $$
declare
  v_type text;
begin
  select data_type into v_type
  from information_schema.columns
  where table_schema = 'public'
    and table_name   = 'admin_activity_log'
    and column_name  = 'detalhes';

  if v_type = 'jsonb' then
    alter table public.admin_activity_log
      alter column detalhes type text
      using (
        case
          when detalhes is null then null
          when jsonb_typeof(detalhes) = 'string' then detalhes #>> '{}'
          else detalhes::text
        end
      );
  end if;
end $$;


